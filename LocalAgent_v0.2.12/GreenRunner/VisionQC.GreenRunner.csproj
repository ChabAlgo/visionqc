    <Reference Include="ViDi.NET.Common"><HintPath>$(CognexDir)\ViDi.NET.Common.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="ViDi.NET.Interfaces"><HintPath>$(CognexDir)\ViDi.NET.Interfaces.dll</HintPath><Private>False</Private></Reference>
