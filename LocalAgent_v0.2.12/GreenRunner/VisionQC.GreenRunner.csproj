    <Reference Include="System.Drawing.Common"><HintPath>..\lib\System.Drawing.Common.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="ViDi.NET"><HintPath>$(CognexDir)\ViDi.NET.dll</HintPath><Private>False</Private></Reference>
