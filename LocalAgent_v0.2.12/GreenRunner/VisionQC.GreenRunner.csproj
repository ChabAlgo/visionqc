    <Compile Include="..\Services\GreenRuntimeFactory.cs" />
    <Compile Include="..\Services\GreenRuntimePolicy.cs" />
    <Compile Include="..\Services\GreenProcessProtocol.cs" />
    <Compile Include="..\Services\VpdlRuntimeCatalog.cs" />
